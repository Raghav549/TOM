# Copy to .env only after supplying real provider endpoints, model IDs, and secrets.
TOM_ENV=production
TOM_HOST=0.0.0.0
TOM_PORT=8787
TOM_DATA_DIR=/var/lib/tom/data
TOM_APPROVAL_REQUIRED=true

# OpenAI-compatible LLM provider.
TOM_LLM_ENABLED=true
TOM_LLM_BASE_URL=
TOM_LLM_API_KEY=
TOM_LLM_MODEL=

# Credential vault and device authentication secrets.
TOM_CREDENTIAL_MASTER_KEY=
TOM_CREDENTIAL_PROVISION_TOKEN=
TOM_DEVICE_SECRETS_JSON=

# Real local voice stack installed by the production image.
TOM_TTS_ENGINE=qwen3
TOM_QWEN3_TTS_STREAM_URL=http://127.0.0.1:8787/v1/tts/qwen3/stream
TOM_QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
TOM_QWEN3_TTS_VOICE_DESIGN_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
TOM_ASR_MODEL=
TOM_ASR_DEVICE=cpu
TOM_ASR_COMPUTE_TYPE=int8
TOM_TURN_MODEL_PATH=/var/lib/tom/models/turn.onnx
TOM_NEURAL_VAD=true

# OpenAI-compatible vision provider.
TOM_VISION_BASE_URL=
TOM_VISION_API_KEY=
TOM_VISION_MODEL=

TOM_BROWSER_HEADLESS=true

# Browser runtime uses Chromium installed in the production image.
TOM_WEB_ORIGIN=