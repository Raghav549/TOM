# Copy to .env only after supplying real provider endpoints, model IDs, and secrets.
TOM_ENV=production
TOM_HOST=0.0.0.0
TOM_PORT=8787
TOM_DATA_DIR=/var/lib/tom/data
TOM_APPROVAL_REQUIRED=true

# /ready checks only the capabilities listed here. Keep live Android connectivity
# out of this list: device connection is operational state, not a boot blocker.
TOM_REQUIRED_CAPABILITIES=device_auth,persistent_data

# OpenAI-compatible LLM provider. ModelScope API-Inference is the tested default.
# Add model here only if TOM must refuse readiness when the provider is unavailable.
TOM_LLM_ENABLED=true
TOM_LLM_BASE_URL=https://api-inference.modelscope.cn/v1
TOM_LLM_API_KEY=
TOM_LLM_MODEL=Qwen/Qwen3-8B

# Credential vault and device authentication secrets.
TOM_CREDENTIAL_MASTER_KEY=
TOM_CREDENTIAL_PROVISION_TOKEN=
TOM_DEVICE_SECRETS_JSON=

# Qwen3-TTS is served by the authoritative GPU session.
# TOM_QWEN3_TTS_STREAM_URL is the exact public /v1/tts/qwen3/stream URL.
# If access is encoded in that URL, leave TOM_QWEN3_TTS_AUTH_TOKEN empty.
# Only set TOM_QWEN3_TTS_AUTH_TOKEN when the TTS server explicitly requires a
# separate Authorization: Bearer token.
TOM_TTS_ENGINE=qwen3
TOM_QWEN3_TTS_STREAM_URL=
TOM_QWEN3_TTS_AUTH_TOKEN=
TOM_QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
TOM_QWEN3_TTS_MODEL_DIR=
TOM_QWEN3_TTS_DEVICE=cuda:0
TOM_QWEN3_TTS_DTYPE=bfloat16
TOM_QWEN3_TTS_CPU_DTYPE=float32

# Optional voice perception capabilities.
TOM_ASR_MODEL=
TOM_ASR_DEVICE=cpu
TOM_ASR_COMPUTE_TYPE=int8
TOM_TURN_MODEL_PATH=
TOM_NEURAL_VAD=true

# Optional OpenAI-compatible vision provider.
TOM_VISION_BASE_URL=
TOM_VISION_API_KEY=
TOM_VISION_MODEL=

# Optional browser capability.
TOM_BROWSER_HEADLESS=true
TOM_WEB_ORIGIN=
