TOM_ENV=development
TOM_HOST=127.0.0.1
TOM_PORT=8787
TOM_DATA_DIR=.tom-data
TOM_DEFAULT_MODEL=local
TOM_APPROVAL_REQUIRED=true
TOM_LLM_ENABLED=false
# Optional OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, etc.)
TOM_LLM_BASE_URL=http://127.0.0.1:11434/v1
TOM_LLM_API_KEY=
TOM_LLM_MODEL=llama3.2

# Base64-encoded >=32-byte secrets keyed by enrolled Android device ID.
# Keep this only in deployment secrets; never commit real credentials.
# TOM_DEVICE_SECRETS_JSON={"android-device-1":"BASE64_32_BYTE_SECRET"}
