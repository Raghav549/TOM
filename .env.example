TOM_ENV=development
TOM_HOST=127.0.0.1
TOM_PORT=8787
TOM_DATA_DIR=.tom-data
TOM_DEFAULT_MODEL=local
TOM_APPROVAL_REQUIRED=true
TOM_LLM_ENABLED=false
TOM_LLM_BASE_URL=
TOM_LLM_API_KEY=
TOM_LLM_MODEL=Qwen/Qwen3-VL-8B-Instruct

# Encrypted credential vault. Use a strong random secret in production.
TOM_CREDENTIAL_MASTER_KEY=
# Protects API-based credential provisioning. Keep this server-side only.
TOM_CREDENTIAL_PROVISION_TOKEN=

# Google OAuth browser connection
TOM_GOOGLE_CLIENT_ID=
TOM_GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI registered in Google Cloud, e.g. https://your-host.example/v1/integrations/google/callback
TOM_GOOGLE_REDIRECT_URI=http://localhost:8787/v1/integrations/google/callback
# Optional frontend origin for the OAuth callback postMessage.
TOM_WEB_ORIGIN=http://localhost:3000

# Realtime voice
TOM_TTS_ENGINE=qwen3
TOM_QWEN3_TTS_STREAM_URL=http://127.0.0.1:8787/v1/tts/qwen3/stream
TOM_QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
TOM_QWEN3_TTS_VOICE_DESIGN_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
TOM_QWEN3_TTS_MODEL_DIR=.models/Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
TOM_QWEN3_TTS_DEVICE=auto
TOM_QWEN3_TTS_DTYPE=bfloat16
TOM_QWEN3_TTS_CPU_DTYPE=float32
TOM_QWEN3_TTS_MIN_RAM_GB=8
TOM_QWEN3_TTS_MIN_VRAM_GB=4
TOM_ASR_MODEL=small
TOM_ASR_DEVICE=cuda
TOM_ASR_COMPUTE_TYPE=float16
TOM_ASR_PARTIAL_INTERVAL_MS=480
TOM_ASR_CONTEXT_MS=3200
TOM_NEURAL_VAD=true
TOM_VAD_THRESHOLD=0.55
TOM_SMART_TURN_MODEL_PATH=.models/smart-turn-v3.2-cpu.onnx
TOM_SMART_TURN_THRESHOLD=0.50
TOM_TURN_MODEL_PATH=
TOM_COSYVOICE_VERSION=3
TOM_COSYVOICE_MODEL_DIR=
TOM_COSYVOICE_REF_TOM_M1=
TOM_COSYVOICE_REF_TOM_M2=
TOM_COSYVOICE_REF_TOM_F1=
TOM_TTS_COMMAND=

# Production gate requirements. Do not enable TOM_ENV=production until every
# required provider below is configured with a real service/model and secret.
# Supported LLM and vision providers must expose an OpenAI-compatible API.
# Supported local voice path: indic-parler TTS plus faster-whisper ASR.
# TOM_TURN_MODEL_PATH must point to a real ONNX turn-prediction model.
# TOM_DEVICE_SECRETS_JSON must be provisioned with real per-device secrets.

# Multimodal vision provider
TOM_VISION_BASE_URL=
TOM_VISION_MODEL=
TOM_VISION_API_KEY=

# Live Android WSS trust. Use base64-encoded >=32-byte secrets in production.
# Example: TOM_DEVICE_SECRETS_JSON={"android-device-1":"BASE64_32_BYTE_SECRET"}
TOM_DEVICE_SECRETS_JSON=

# Explicit real integration providers. Empty means unavailable; TOM never fakes them.
TOM_API_WEATHER_ENABLED=true
TOM_API_GEOCODING_ENABLED=true
TOM_API_CURRENCY_ENABLED=true
TOM_MAPS_PROVIDER=
TOM_FLIGHTS_PROVIDER=
TOM_PLACES_PROVIDER=
TOM_NEWS_PROVIDER=
TOM_CALENDAR_PROVIDER=
TOM_EMAIL_PROVIDER=
TOM_MESSAGING_PROVIDER=
TOM_FINANCE_PROVIDER=
TOM_TRANSPORT_PROVIDER=
TOM_PAYMENTS_PROVIDER=

# Legacy environment fallbacks for provider adapters. Prefer /v1/credentials.
TOM_GOOGLE_MAPS_API_KEY=
TOM_AVIATIONSTACK_KEY=
TOM_MARKETSTACK_KEY=
TOM_SERPSTACK_KEY=
TOM_MAILBOXLAYER_KEY=
TOM_TWILIO_ACCOUNT_SID=
TOM_TWILIO_AUTH_TOKEN=
TOM_TWILIO_FROM_NUMBER=
