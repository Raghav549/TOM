TOM_ENV=development
TOM_HOST=127.0.0.1
TOM_PORT=8787
TOM_DATA_DIR=.tom-data
TOM_DEFAULT_MODEL=local
TOM_APPROVAL_REQUIRED=true
TOM_LLM_ENABLED=false
TOM_LLM_BASE_URL=http://127.0.0.1:11434/v1
TOM_LLM_API_KEY=
TOM_LLM_MODEL=llama3.2

# Realtime voice
TOM_TTS_ENGINE=indic-parler
TOM_INDIC_PARLER_MODEL=ai4bharat/indic-parler-tts
TOM_ASR_MODEL=small
TOM_ASR_DEVICE=cuda
TOM_ASR_COMPUTE_TYPE=float16
TOM_ASR_PARTIAL_INTERVAL_MS=480
TOM_ASR_CONTEXT_MS=3200
TOM_NEURAL_VAD=true
TOM_VAD_THRESHOLD=0.55
TOM_SMART_TURN_MODEL_PATH=.models/smart-turn-v3.2-cpu.onnx
TOM_SMART_TURN_THRESHOLD=0.50
TOM_TURN_MODEL_PATH=
TOM_COSYVOICE_VERSION=3
TOM_COSYVOICE_MODEL_DIR=
TOM_COSYVOICE_REF_TOM_M1=
TOM_COSYVOICE_REF_TOM_M2=
TOM_COSYVOICE_REF_TOM_F1=
TOM_TTS_COMMAND=

# Multimodal vision provider
TOM_VISION_BASE_URL=
TOM_VISION_MODEL=
TOM_VISION_API_KEY=

# Live Android WSS trust. Use base64-encoded >=32-byte secrets in production.
# Example: TOM_DEVICE_SECRETS_JSON={"android-device-1":"BASE64_32_BYTE_SECRET"}
TOM_DEVICE_SECRETS_JSON=

# Explicit real integration providers. Empty means unavailable; TOM never fakes them.
TOM_API_WEATHER_ENABLED=true
TOM_API_GEOCODING_ENABLED=true
TOM_API_CURRENCY_ENABLED=true
TOM_MAPS_PROVIDER=
TOM_FLIGHTS_PROVIDER=
TOM_PLACES_PROVIDER=
TOM_NEWS_PROVIDER=
TOM_CALENDAR_PROVIDER=
TOM_EMAIL_PROVIDER=
TOM_MESSAGING_PROVIDER=
TOM_FINANCE_PROVIDER=
TOM_TRANSPORT_PROVIDER=
TOM_PAYMENTS_PROVIDER=
