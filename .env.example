TOM_ENV=development
TOM_HOST=127.0.0.1
TOM_PORT=8787
TOM_DATA_DIR=.tom-data
TOM_DEFAULT_MODEL=local
TOM_APPROVAL_REQUIRED=true
TOM_LLM_ENABLED=false
# Optional OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, etc.)
TOM_LLM_BASE_URL=http://127.0.0.1:11434/v1
TOM_LLM_API_KEY=
TOM_LLM_MODEL=llama3.2

# Live voice ASR (optional dependency group: pip install -e '.[voice]')
TOM_ASR_MODEL=small
TOM_ASR_DEVICE=cuda
TOM_ASR_COMPUTE_TYPE=float16

# Real streaming CosyVoice model directory.
# Install the official CosyVoice runtime separately and point this at a local model.
TOM_COSYVOICE_VERSION=3
TOM_COSYVOICE_MODEL_DIR=
TOM_COSYVOICE_REF_TOM_M1=
TOM_COSYVOICE_REF_TOM_M2=
TOM_COSYVOICE_REF_TOM_F1=

# Legacy non-streaming command adapter remains available for /v1/voice/synthesize.
TOM_TTS_COMMAND=

# Base64-encoded >=32-byte secrets keyed by enrolled Android device ID.
# Keep this only in deployment secrets; never commit real credentials.
# TOM_DEVICE_SECRETS_JSON={"android-device-1":"BASE64_32_BYTE_SECRET"}
