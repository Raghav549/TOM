TOM_ENV=development
TOM_HOST=127.0.0.1
TOM_PORT=8787
TOM_DATA_DIR=.tom-data
TOM_DEFAULT_MODEL=local
TOM_APPROVAL_REQUIRED=true
TOM_LLM_ENABLED=false
TOM_LLM_BASE_URL=http://127.0.0.1:11434/v1
TOM_LLM_API_KEY=
TOM_LLM_MODEL=llama3.2

# Realtime voice
TOM_TTS_ENGINE=indic-parler
TOM_INDIC_PARLER_MODEL=ai4bharat/indic-parler-tts
TOM_ASR_MODEL=small
TOM_ASR_DEVICE=cuda
TOM_ASR_COMPUTE_TYPE=float16
TOM_ASR_PARTIAL_INTERVAL_MS=480
TOM_ASR_CONTEXT_MS=3200

# Neural VAD
TOM_NEURAL_VAD=true
TOM_VAD_THRESHOLD=0.55

# Published Smart Turn v3.2 CPU ONNX (BSD-2-Clause).
# Download with scripts/download_voice_models.py.
TOM_SMART_TURN_MODEL_PATH=.models/smart-turn-v3.2-cpu.onnx
TOM_SMART_TURN_THRESHOLD=0.50

# Optional custom learned multimodal turn model. If configured, TOM also emits
# its predictions; Smart Turn remains the primary semantic endpoint detector.
TOM_TURN_MODEL_PATH=

# CosyVoice remains available as an alternative TTS engine.
TOM_COSYVOICE_VERSION=3
TOM_COSYVOICE_MODEL_DIR=
TOM_COSYVOICE_REF_TOM_M1=
TOM_COSYVOICE_REF_TOM_M2=
TOM_COSYVOICE_REF_TOM_F1=
TOM_TTS_COMMAND=

# Never commit real device secrets.
# TOM_DEVICE_SECRETS_JSON={"android-device-1":"BASE64_32_BYTE_SECRET"}
